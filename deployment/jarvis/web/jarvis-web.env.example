# SECRET. Install the real file as /etc/jarvis/web.env, harry:harry, mode 0600.
JARVIS_DATABASE_URL=postgresql+psycopg://jarvis_app:REPLACE@127.0.0.1:5433/jarvis
JARVIS_ALLOWED_TAILSCALE_LOGIN=REPLACE_WITH_EXACT_LOGIN

# Deployment-derived and non-secret composition. No Provider/PDI credential belongs here.
JARVIS_ALLOWED_ORIGIN=https://pdi-server.tailfdc57b.ts.net
JARVIS_STATIC_DIR=/opt/jarvis-web/current/static
JARVIS_HERMES_BRIDGE_COMMAND=/usr/local/libexec/jarvis-web-hermes-bridge
JARVIS_PDI_MCP_COMMAND=/srv/projects/PDI/deployment/jarvis/pdi-mcp
JARVIS_RESOURCE_ACCESS_SOCKET=/run/pdi/resource-access.sock
JARVIS_BIND_HOST=127.0.0.1
JARVIS_BIND_PORT=8765
JARVIS_RUNTIME_TIMEOUT_SECONDS=600
JARVIS_RUNTIME_INTERRUPT_GRACE_SECONDS=2
JARVIS_RUNTIME_TERMINATE_GRACE_SECONDS=2
JARVIS_RUNTIME_MAX_REQUEST_BYTES=1048576
JARVIS_RUNTIME_MAX_LINE_BYTES=262144
JARVIS_RUNTIME_MAX_STDERR_BYTES=65536
JARVIS_RUNTIME_MAX_VISIBLE_BYTES=4194304
JARVIS_PDI_TIMEOUT_SECONDS=20
JARVIS_PDI_MAX_HYDRATION_REFS=8
JARVIS_RESOURCE_ACCESS_TIMEOUT_SECONDS=20
