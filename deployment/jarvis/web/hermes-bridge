#!/bin/sh
set -eu
umask 077

readonly MODEL_ENV=/etc/jarvis/model.env
readonly HERMES_PYTHON="${HERMES_PYTHON:-/opt/hermes/venv/bin/python}"
readonly RESOLVED_SELF="$(readlink -f "$0")"
readonly RELEASE_ROOT="$(dirname "$(dirname "$RESOLVED_SELF")")"
readonly HERMES_PROFILE="$RELEASE_ROOT/profile/jarvis-web"
readonly BRIDGE="$RELEASE_ROOT/hermes/hermes_bridge.py"

if [ ! -r "$MODEL_ENV" ]; then
    echo "jarvis-web-hermes-bridge: model authority unavailable" >&2
    exit 1
fi

# shellcheck disable=SC1090
. "$MODEL_ENV"
if [ -z "${DEEPSEEK_API_KEY:-}" ]; then
    echo "jarvis-web-hermes-bridge: model credential unavailable" >&2
    exit 1
fi
if [ ! -x "$HERMES_PYTHON" ] || [ ! -r "$HERMES_PROFILE/config.yaml" ] || [ ! -r "$BRIDGE" ]; then
    echo "jarvis-web-hermes-bridge: runtime artifact unavailable" >&2
    exit 1
fi

exec env -i \
    HOME=/var/lib/jarvis \
    USER=jarvis \
    LOGNAME=jarvis \
    PATH=/usr/local/bin:/usr/bin:/bin \
    LANG=C.UTF-8 \
    HERMES_HOME="$HERMES_PROFILE" \
    DEEPSEEK_API_KEY="$DEEPSEEK_API_KEY" \
    "$HERMES_PYTHON" "$BRIDGE"
