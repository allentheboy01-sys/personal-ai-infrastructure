# Copy only the required groups to /etc/pdi/pdi.env on the runtime host.
# Never commit credentials or a populated environment file.
# Restrict the deployed file to its runtime owner (mode 600).
# Use deployment-local production endpoints; never use a test database.

# Required for PDI persistence.
DATABASE__URL=postgresql+psycopg://pdi:replace-with-strong-password@127.0.0.1:5432/pdi

# Optional Nextcloud Provider. Set all values together when enabled.
# NEXTCLOUD__URL=https://nextcloud.example.internal
# NEXTCLOUD__USER=pdi-reader
# NEXTCLOUD__PASSWORD=replace-with-nextcloud-app-password

# Optional Immich Provider. Set both values together when enabled.
# IMMICH__URL=https://immich.example.internal
# IMMICH__API_KEY=replace-with-read-only-immich-api-key

# Optional explicit/manual Gmail pilot.
# GMAIL__TOKEN_FILE=/etc/pdi/gmail-oauth-token.json

LOGGING__LEVEL=INFO
