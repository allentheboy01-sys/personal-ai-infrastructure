[Unit]
Description=PDI Immich provider synchronization
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=harry
WorkingDirectory=/srv/projects/PDI
EnvironmentFile=/etc/pdi/pdi.env
ExecStart=/usr/bin/flock --exclusive --wait 3600 /run/lock/pdi-sync.lock /srv/projects/PDI/.venv/bin/python -m pdi.main --provider immich
TimeoutStartSec=12h
UMask=0077
StandardOutput=journal
StandardError=journal
