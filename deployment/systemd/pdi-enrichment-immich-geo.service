[Unit]
Description=PDI Immich provider-derived geo observation enrichment
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=pdi
Group=pdi
WorkingDirectory=/opt/pdi
EnvironmentFile=/etc/pdi/pdi.env
ExecStart=/opt/pdi/.venv/bin/python -m pdi.operational --pipeline-key enrichment.immich_geo --lock-timeout 3600
TimeoutStartSec=90m
UMask=0077
StandardOutput=journal
StandardError=journal
