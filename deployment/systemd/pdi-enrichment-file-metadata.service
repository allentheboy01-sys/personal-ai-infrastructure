[Unit]
Description=PDI file metadata temporal observation enrichment
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=harry
WorkingDirectory=/srv/projects/PDI
EnvironmentFile=/etc/pdi/pdi.env
ExecStart=/srv/projects/PDI/.venv/bin/python -m pdi.operational --pipeline-key enrichment.file_metadata --lock-timeout 3600
TimeoutStartSec=1h
UMask=0077
StandardOutput=journal
StandardError=journal
