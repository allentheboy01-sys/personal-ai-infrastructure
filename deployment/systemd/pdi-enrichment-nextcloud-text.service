[Unit]
Description=PDI Nextcloud text observation enrichment
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=pdi
Group=pdi
WorkingDirectory=/opt/pdi
EnvironmentFile=/etc/pdi/pdi.env
ExecStart=/opt/pdi/.venv/bin/python -m pdi.operational --pipeline-key enrichment.nextcloud_text --lock-timeout 3600
TimeoutStartSec=2h
UMask=0077
StandardOutput=journal
StandardError=journal
