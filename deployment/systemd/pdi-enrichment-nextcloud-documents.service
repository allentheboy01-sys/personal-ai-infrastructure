[Unit]
Description=PDI Nextcloud rich document observation enrichment
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=pdi
Group=pdi
WorkingDirectory=/opt/pdi
EnvironmentFile=/etc/pdi/pdi.env
ExecStart=/opt/pdi/.venv/bin/python -m pdi.operational --pipeline-key enrichment.nextcloud_documents --lock-timeout 1800
TimeoutStartSec=30m
UMask=0077
StandardOutput=journal
StandardError=journal
