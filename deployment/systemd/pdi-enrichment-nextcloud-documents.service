[Unit]
Description=PDI Nextcloud rich document observation enrichment
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=harry
WorkingDirectory=/srv/projects/PDI
EnvironmentFile=/etc/pdi/pdi.env
ExecStart=/usr/bin/flock --exclusive --wait 1800 /run/lock/pdi-sync.lock /srv/projects/PDI/.venv/bin/python -m pdi.enrichment --extractor nextcloud-documents --batch-size 100
TimeoutStartSec=30m
UMask=0077
StandardOutput=journal
StandardError=journal
