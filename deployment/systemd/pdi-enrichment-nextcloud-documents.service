[Unit]
Description=PDI Nextcloud rich document observation enrichment
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=harry
WorkingDirectory=/srv/projects/PDI
EnvironmentFile=/etc/pdi/pdi.env
ExecStart=/srv/projects/PDI/.venv/bin/python -m pdi.operational --pipeline-key enrichment.nextcloud_documents --lock-timeout 1800
TimeoutStartSec=30m
UMask=0077
StandardOutput=journal
StandardError=journal
