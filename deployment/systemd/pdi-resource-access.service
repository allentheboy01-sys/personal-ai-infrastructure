[Unit]
Description=PDI read-only Resource Access service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pdi
Group=pdi
WorkingDirectory=/opt/pdi
ExecStart=/opt/pdi/deployment/resource-access/pdi-resource-access
Restart=on-failure
RestartSec=2s
RuntimeDirectory=pdi
RuntimeDirectoryMode=0700
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
