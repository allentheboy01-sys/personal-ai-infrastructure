# PDI persistence (required).
DATABASE__URL=postgresql+psycopg://pdi:replace-with-strong-password@127.0.0.1:5432/pdi

# Nextcloud Provider (optional; configure all three values together).
# NEXTCLOUD__URL=https://nextcloud.example.internal
# NEXTCLOUD__USER=pdi-reader
# NEXTCLOUD__PASSWORD=replace-with-nextcloud-app-password

# Immich Provider and optional semantic retrieval (optional; configure both).
# IMMICH__URL=https://immich.example.internal
# IMMICH__API_KEY=replace-with-read-only-immich-api-key

# Gmail Provider is an explicit manual pilot; it is never implicitly synced.
# GMAIL__TOKEN_FILE=/etc/pdi/gmail-oauth-token.json

LOGGING__LEVEL=INFO

# Development integration tests only. Never point this at production.
# PDI_TEST_DATABASE_URL=postgresql+psycopg://pdi_test:replace-me@127.0.0.1:5432/pdi_test
